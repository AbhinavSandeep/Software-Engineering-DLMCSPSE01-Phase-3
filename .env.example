# Copy to .env and change the values. Never commit the real .env file.
APP_ENV=production
SECRET_KEY=replace-with-a-long-random-string
POSTGRES_USER=xptoirl
POSTGRES_PASSWORD=replace-with-a-strong-password
POSTGRES_DB=xptoirl
# Used by docker compose; for a cloud database set the full URL instead.
DATABASE_URL=postgresql+psycopg://xptoirl:replace-with-a-strong-password@db:5432/xptoirl
# Optional: created on first start if both are set.
ADMIN_EMAIL=
ADMIN_PASSWORD=
